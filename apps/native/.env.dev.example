# The dev build, run from a laptop: see apps/native/README.md. Copy to .env.dev,
# which is gitignored. app.config.ts loads it when APP_ENV is dev, the default.

# The App ID registered in the Apple Developer account, also the Android package.
APP_BUNDLE_ID=com.protechcloud.medusa.dev

# PostHog. Unset disables the SDK: the app sends nothing.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com

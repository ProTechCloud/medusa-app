# Local development only. Copy to .env.local, which is gitignored; `yarn dev` reads it.
# bin/local-*.sh also source it as bash, so quote a value with spaces, < or >.
APP_ENV=local
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Postgres, from docker-compose.yml. `yarn local:create` starts it with these
# values, so change them here, before creating it.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medusa
DB_USER=medusa
DB_PASSWORD=medusadev

# The Pub/Sub emulator, from docker-compose.yml. With PUBSUB_EMULATOR_HOST set
# the client talks to it and needs no Google credentials. Its push
# subscription delivers each email to the worker on WORKER_PORT.
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=medusa-local
PUBSUB_EMAILS_TOPIC=emails
WORKER_PORT=8082
# Who may push to a deployed worker: unset locally, where the emulator sends
# no token and every push is trusted.
# PUBSUB_PUSH_AUDIENCE=
# PUBSUB_PUSH_SERVICE_ACCOUNT=

# Better Auth. The secret signs its tokens: generate your own, at least 32
# characters, with `openssl rand -base64 32`, and never commit it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# How many proxies append to X-Forwarded-For in front of the API; the
# client's address is the entry before theirs. 1 is Cloud Run's load balancer.
# TRUSTED_PROXIES=1

# Mailgun, for the worker. Without the key no email is sent, and the worker
# logs the subject, with the address redacted, instead. A local API accepts the code 111111
# beside the emailed one either way. With the key, the domain it sends from
# and the From address are required too.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM="Medusa <no-reply@your-domain>"
# Unset is Mailgun's US API; a domain in the EU region needs this one.
# MAILGUN_API_URL=https://api.eu.mailgun.net

# `yarn migrate` applies the migrations only when this is true; local:create
# sets it for its own run.
# SHOULD_RUN_MIGRATION=false

# PostHog. Without a token nothing is sent and the API runs the same. To try
# it, copy the project token from PostHog → Project settings.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com
# One switch per signal, each on unless set to false.
# POSTHOG_TRACES=true
# POSTHOG_LOGS=true
# POSTHOG_ERRORS=true
# The error client's queue; unset keeps posthog-node's defaults.
# POSTHOG_MAX_QUEUE_SIZE=
# POSTHOG_FLUSH_AT=
# POSTHOG_FLUSH_INTERVAL_MS=

# Logs: stdout on or off, and the lowest level sent to PostHog, LOG_LEVEL's
# unless set.
# LOG_STDOUT=true
# LOG_POSTHOG_LEVEL=warn

# OpenTelemetry. The share of new traces kept, 0 to 1; the SDK's own
# problems on stderr; and, when the default batching does not fit, the
# OTEL_BSP_* (spans) and OTEL_BLRP_* (log records) batch settings.
# OTEL_TRACES_SAMPLER_ARG=1
# OTEL_LOG_LEVEL=warn
# OTEL_SERVICE_NAME=api

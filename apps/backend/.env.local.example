# Local development only. Copy to .env.local, which is gitignored; `yarn dev` reads it.
APP_ENV=local
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=pretty

# PostHog. Without a token nothing is sent and the API runs the same. To try
# it, copy the project token from PostHog → Project settings.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com
# One switch per signal, each on unless set to false.
# POSTHOG_TRACES=true
# POSTHOG_LOGS=true
# POSTHOG_ERRORS=true
# The error client's queue; unset keeps posthog-node's defaults.
# POSTHOG_MAX_QUEUE_SIZE=
# POSTHOG_FLUSH_AT=
# POSTHOG_FLUSH_INTERVAL_MS=

# Logs: stdout on or off, and the lowest level sent to PostHog.
# LOG_STDOUT=true
# LOG_POSTHOG_LEVEL=warn

# OpenTelemetry. The share of new traces kept, 0 to 1; the SDK's own
# problems on stderr; and, when the default batching does not fit, the
# OTEL_BSP_* (spans) and OTEL_BLRP_* (log records) batch settings.
# OTEL_TRACES_SAMPLER_ARG=1
# OTEL_LOG_LEVEL=warn
# OTEL_SERVICE_NAME=api

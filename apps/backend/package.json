{
	"name": "@medusa/backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"codegen": "graphql-codegen --config codegen.yml",
		"dev": "bun --watch --env-file=.env.local src/services/api/index.ts",
		"dev:worker": "bun --watch --env-file=.env.local src/services/worker/index.ts",
		"start": "bun run src/services/api/index.ts",
		"migrate": "bun --env-file=.env.local src/services/migrate/index.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "biome check --error-on-warnings .",
		"format:write": "biome check --write ."
	},
	"dependencies": {
		"@google-cloud/pubsub": "^6.4.1",
		"@hono/otel": "~1.3.0",
		"@medusa/db": "workspace:*",
		"@medusa/emails": "workspace:*",
		"@medusa/events": "workspace:*",
		"@medusa/gql": "workspace:*",
		"@opentelemetry/api": "~1.9.1",
		"@opentelemetry/api-logs": "~0.223.0",
		"@opentelemetry/core": "^2.12.0",
		"@opentelemetry/exporter-logs-otlp-proto": "~0.223.0",
		"@opentelemetry/exporter-trace-otlp-proto": "~0.223.0",
		"@opentelemetry/resources": "^2.12.0",
		"@opentelemetry/sdk-logs": "~0.223.0",
		"@opentelemetry/sdk-node": "~0.223.0",
		"@opentelemetry/sdk-trace-base": "^2.12.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"better-auth": "^1.7.22",
		"drizzle-orm": "~0.45.4",
		"graphql": "^16.15.0",
		"graphql-yoga": "^6.1.0",
		"hono": "^4.6.14",
		"lru-cache": "^11.5.3",
		"pino": "^10.4.0",
		"posthog-node": "~5.57.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@faker-js/faker": "^10.6.0",
		"@graphql-codegen/add": "^8.0.0",
		"@graphql-codegen/cli": "^8.0.0",
		"@graphql-codegen/typescript": "^7.0.1",
		"@graphql-codegen/typescript-resolvers": "^7.0.1",
		"@graphql-typed-document-node/core": "^3.2.0",
		"@opentelemetry/context-async-hooks": "^2.12.0",
		"@testcontainers/postgresql": "^12.2.1",
		"@types/bun": "^1.1.14",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-istanbul": "^5.0.5",
		"eslint": "^9.0.0",
		"graphql-codegen-typescript-validation-schema": "^0.19.0",
		"pg": "^8.23.1",
		"pino-pretty": "^13.2.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}

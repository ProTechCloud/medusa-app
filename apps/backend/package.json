{
	"name": "@medusa/backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch --env-file=.env.local src/services/api/index.ts",
		"start": "bun run src/services/api/index.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "biome check --error-on-warnings .",
		"format:write": "biome check --write ."
	},
	"dependencies": {
		"hono": "^4.6.14",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@faker-js/faker": "^10.6.0",
		"@types/bun": "^1.1.14",
		"@vitest/coverage-istanbul": "^5.0.5",
		"eslint": "^9.0.0",
		"pino-pretty": "^13.2.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}

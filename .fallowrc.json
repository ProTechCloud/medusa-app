{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"ignorePatterns": [
		"**/__mocks__/**",
		"apps/native/ios/**",
		"apps/native/android/**"
	],
	"dynamicallyLoaded": [
		"**/testing/mock-*.{ts,tsx}",
		"**/__mocks__/**"
	],
	"rules": {
		"unused-types": "error"
	},
	"ignoreDependencies": [
		"expo-dev-client",
		"babel-preset-expo"
	]
}

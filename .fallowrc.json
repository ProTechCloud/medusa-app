{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"ignorePatterns": [
		".github/pr-template/**",
		"apps/native/ios/**",
		"apps/native/android/**"
	],
	"dynamicallyLoaded": [
		"**/testing/mock-*.{ts,tsx}",
		"**/__mocks__/**",
		"packages/gql/schema/**/*.graphql",
		"packages/gql/operations/**/*.graphql"
	],
	"rules": {
		"unused-types": "error"
	},
	"ignoreDependencies": [
		"expo-dev-client",
		"babel-preset-expo",
		"@posthog/react-native-plugin",
		"@graphql-typed-document-node/core",
		"graphql-codegen-typescript-validation-schema"
	]
}

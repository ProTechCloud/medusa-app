{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": [
		"tsconfig.json",
		"biome.json",
		"eslint.config.mjs",
		".nvmrc"
	],
	"globalEnv": ["NODE_ENV"],
	"globalPassThroughEnv": [
		"CI",
		"FORCE_COLOR",
		"GITHUB_*",
		"ACTIONS_*",
		"TURBO_*"
	],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {},
		"lint": {},
		"format": {},
		"format:write": {
			"cache": false
		},
		"test": {},
		"test:coverage": {
			"outputs": ["coverage/**"]
		}
	}
}

{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": ["tsconfig.json", "biome.json", ".nvmrc"],
	"tasks": {
		"dev": {
			"persistent": true,
			"cache": false
		},
		"test": {
			"outputs": []
		},
		"typecheck": {
			"outputs": []
		},
		"lint": {
			"outputs": []
		},
		"lint:fix": {
			"cache": false
		}
	}
}
